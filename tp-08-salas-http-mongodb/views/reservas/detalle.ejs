<section>
  <h2>Detalle de la reserva</h2>

  <article class="reserva">

    <h3>Reserva #<%= reserva.id %></h3>

    <p>
      <strong>Estudiante:</strong>
      <%= reserva.estudiante %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= reserva.email %>
    </p>

    <p>
      <strong>Sala:</strong>
      <%= reserva.sala %>
    </p>

    <p>
      <strong>Fecha:</strong>
      <%= reserva.fecha %>
    </p>

    <p>
      <strong>Turno:</strong>
      <%= reserva.turno %>
    </p>

    <p>
      <strong>Cantidad de personas:</strong>
      <%= reserva.personas %>
    </p>

  </article>

  <div class="acciones">
    <a href="/reservas">Volver al listado</a>
    <a href="/reservas/nueva">Nueva reserva</a>
  </div>
</section>